{
  "name": "@olbos/mcp",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "olbos-mcp": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@olbos/sdk": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
